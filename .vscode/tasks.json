{
  "version": "2.0.0",
  "options": { "cwd": "${workspaceFolder}" },
  "tasks": [
    {
      "label": "undepRcate: Launch",
      "type": "process",
      "command": "Rscript",
      "args": ["--vanilla", "run.R"],
      "windows": {
        "command": "cmd.exe",
        "args": ["/d", "/c", "scripts\\start.cmd", "run.R"]
      },
      "problemMatcher": []
    },
    {
      "label": "undepRcate: Restore dependencies",
      "type": "process",
      "command": "Rscript",
      "args": ["--vanilla", "scripts/setup.R"],
      "windows": {
        "command": "cmd.exe",
        "args": ["/d", "/c", "scripts\\start.cmd", "scripts/setup.R"]
      },
      "problemMatcher": []
    },
    {
      "label": "undepRcate: Run tests",
      "type": "process",
      "command": "Rscript",
      "args": ["--vanilla", "tests/testthat.R"],
      "windows": {
        "command": "cmd.exe",
        "args": ["/d", "/c", "scripts\\start.cmd", "tests/testthat.R"]
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
